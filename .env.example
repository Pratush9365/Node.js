DB_HOST=localhost
DB_PORT=5432
DB_NAME=school
DB_USER=postgres
DB_PASSWORD=your-password
PORT=3000
PASS_PERCENTAGE=33.5
ACADEMIC_YEAR=2026-27
# At least 32 random characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
# Comma separated full origins. "*" is rejected on purpose.
CORS_ORIGINS=http://localhost:3000
# Max POST /api/students/:id/marks requests per user per 10 minutes.
MARKS_RATE_LIMIT_MAX=60
